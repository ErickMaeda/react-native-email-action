{
  "name": "react-native-email-action",
  "version": "1.1.0",
  "description": "A simple and customized way to open email linking (Best option for iOS that will ask you what email provider you can use)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .js,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.ts,.tsx --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build": "tsc -p tsconfig.json",
    "prepare": "yarn build",
    "prepublishOnly": "yarn build",
    "lint-staged": "lint-staged",
    "changeset": "changeset",
    "version": "changeset version && yarn build",
    "release": "yarn build && changeset publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErickMaeda/react-native-email-action.git"
  },
  "keywords": [
    "react-native",
    "react-component",
    "react-native-component",
    "react",
    "react native",
    "mobile",
    "ios",
    "android",
    "email",
    "email-action",
    "ios-email",
    "gmail",
    "outlook",
    "mail"
  ],
  "author": "Erick Maeda",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ErickMaeda/react-native-email-action/issues"
  },
  "homepage": "https://github.com/ErickMaeda/react-native-email-action#readme",
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.10",
    "@eslint/js": "^9.39.2",
    "@react-native/babel-preset": "^0.83.1",
    "@react-native/metro-config": "^0.83.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "babel-jest": "^30.2.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-native": "^5.0.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "react": "^19.2.3",
    "react-native": "^0.83.1",
    "react-test-renderer": "^19.2.3",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "**/*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write"
    ]
  }
}
